{
  "name": "blendsbya",
  "private": true,
  "version": "0.1.0",
  "description": "Blendsbya — art and make up portfolio. Sanity Studio (/studio) + Astro frontend (/web).",
  "workspaces": [
    "studio",
    "web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev --workspace web",
    "dev:web": "npm run dev --workspace web",
    "dev:studio": "npm run dev --workspace studio",
    "build": "npm run build --workspace web",
    "build:web": "npm run build --workspace web",
    "build:studio": "npm run build --workspace studio",
    "check": "npm run check --workspace web",
    "deploy:studio": "npm run deploy --workspace studio"
  }
}
