# --- Sanity -----------------------------------------------------------------
# Project ID from sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=
# "development" for local work and the dev branch preview, "production" for main.
# Set per environment in Cloudflare Pages (Production vs Preview).
PUBLIC_SANITY_DATASET=development

# --- Forms ------------------------------------------------------------------
# Formspree form endpoint, e.g. https://formspree.io/f/abcdwxyz
PUBLIC_FORMSPREE_ENDPOINT=

# --- Feature flags ----------------------------------------------------------
# "true" shows the Buy button (Stripe, later). "false" shows the enquiry form.
PUBLIC_ENABLE_COMMERCE=false

# --- Optional ---------------------------------------------------------------
# Canonical site URL (custom domain). Falls back to CF_PAGES_URL on Cloudflare.
# PUBLIC_SITE_URL=https://blendsbya.art
