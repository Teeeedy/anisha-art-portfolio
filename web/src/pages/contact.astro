---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getSiteSettings } from '../lib/site';

const settings = await getSiteSettings();
---

<BaseLayout title="Contact" description="Commissions, collaborations and general enquiries — get in touch with Anisha.">
  <section class="contact container section">
    <header class="contact__intro">
      <h1 class="page-title">Get in touch</h1>
      <p class="muted">Commissions, collaborations, or just to say hello.</p>
    </header>

    <ContactForm email={settings.email} />

    <footer class="contact__links">
      {
        settings.email && (
          <p>
            <a href={`mailto:${settings.email}`}>{settings.email}</a>
          </p>
        )
      }
      <SocialLinks
        instagramUrl={settings.instagramUrl}
        youtubeUrl={settings.youtubeUrl}
        email={settings.email}
        class="contact__social"
      />
    </footer>
  </section>
</BaseLayout>

<style>
  .contact {
    max-width: 34rem;
    display: grid;
    gap: var(--space-6);
  }

  .contact__intro {
    text-align: center;
  }

  .contact__intro .page-title {
    margin-bottom: var(--space-2);
  }

  .contact__links {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
    text-align: center;
  }

  .contact__links a {
    text-decoration: underline;
  }

  .contact__links :global(.contact__social a) {
    text-decoration: none;
  }
</style>
