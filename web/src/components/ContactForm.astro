---
import { ENQUIRY_TYPES } from '../lib/site';

interface Props {
  email?: string | null;
}

const { email } = Astro.props;
const endpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT?.trim() || '';
---

<form
  class="form contact-form"
  method="POST"
  action={endpoint || undefined}
  novalidate
  data-form
  data-success-message="Thanks — your message has been sent. I'll reply as soon as I can."
>
  <input type="hidden" name="_subject" value="Website contact" />
  <input type="hidden" name="url" value="" />

  <div class="field">
    <label class="field__label" for="contact-name">Name</label>
    <input class="field__input" id="contact-name" name="name" type="text" autocomplete="name" required data-validate />
    <p class="field__error" data-error-for="name" aria-live="polite"></p>
  </div>

  <div class="field">
    <label class="field__label" for="contact-email">Email</label>
    <input class="field__input" id="contact-email" name="email" type="email" autocomplete="email" required data-validate />
    <p class="field__error" data-error-for="email" aria-live="polite"></p>
  </div>

  <div class="field">
    <label class="field__label" for="contact-type">Enquiry type</label>
    <select class="field__input" id="contact-type" name="enquiryType" required data-validate>
      <option value="" disabled selected>Select one</option>
      {ENQUIRY_TYPES.map((type) => <option value={type}>{type}</option>)}
    </select>
    <p class="field__error" data-error-for="enquiryType" aria-live="polite"></p>
  </div>

  <div class="field">
    <label class="field__label" for="contact-message">Message</label>
    <textarea class="field__input" id="contact-message" name="message" rows="6" required minlength="10" data-validate
    ></textarea>
    <p class="field__error" data-error-for="message" aria-live="polite"></p>
  </div>

  <p class="hp" aria-hidden="true">
    <label>Leave this field empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </p>

  <button class="btn btn--block" type="submit">Send</button>
  <p class="form__status" data-form-status role="status" aria-live="polite"></p>

  {
    !endpoint && email && (
      <p class="small muted">
        Or email <a href={`mailto:${email}`}>{email}</a>
      </p>
    )
  }
</form>

<script>
  import '../scripts/forms';
</script>
