---
import { NAV_ITEMS, isActivePath } from '../lib/site';

interface Props {
  variant?: 'default' | 'overlay';
  siteTitle: string;
}

const { variant = 'default', siteTitle } = Astro.props;
const current = Astro.url.pathname;
---

<header class:list={['header', `header--${variant}`]}>
  <div class="container header__inner">
    <a class="header__logo" href="/" aria-label={`${siteTitle} — home`}>{siteTitle}</a>
    <nav class="header__nav" aria-label="Primary">
      <ul>
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href} aria-current={isActivePath(current, item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    height: var(--header-h);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg);
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .header__logo {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .header__logo:hover {
    text-decoration: none;
  }

  .header__nav ul {
    display: flex;
    gap: clamp(var(--space-3), 3vw, var(--space-6));
  }

  .header__nav a {
    display: inline-block;
    padding-block: var(--space-2);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    color: var(--color-muted);
    transition: color var(--dur) var(--ease);
  }

  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    color: var(--color-fg);
    text-decoration: none;
  }

  .header__nav a[aria-current='page'] {
    text-decoration: underline;
  }

  /* Overlay variant: transparent, floats over the hero. The hero carries the
     brand title, so the logo is kept for assistive tech only. */
  .header--overlay {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 10;
    background: transparent;
    border-bottom: 0;
    color: var(--color-on-dark);
  }

  .header--overlay .header__logo {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .header--overlay .header__logo:focus-visible {
    position: static;
    width: auto;
    height: auto;
    clip-path: none;
  }

  .header--overlay .header__inner {
    justify-content: flex-end;
  }

  .header--overlay .header__nav a {
    color: rgba(255, 255, 255, 0.75);
  }

  .header--overlay .header__nav a:hover,
  .header--overlay .header__nav a[aria-current='page'] {
    color: var(--color-on-dark);
  }

  .header--overlay :focus-visible {
    outline-color: var(--color-on-dark);
  }
</style>
